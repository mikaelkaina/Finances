@page "/income"
@using Financeiro.App.Client.DTOs.IncomeDtos
@using Financeiro.App.Client.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

@inject IncomeService IncomeService

<h3>Adicionar Receita</h3>

<div class="mb-3">
    <label>Valor</label>
    <input type="number" class="form-control" @bind="Amount" />
</div>

<div class="mb-3">
    <label>Descrição</label>
    <input class="form-control" @bind="Description" />
</div>

<div class="mb-3">
    <label>Data</label>
    <input type="date" class="form-control" @bind="Date" />
</div>

<button class="btn btn-primary" @onclick="Salvar" disabled="@_loading">
    Salvar
</button>

@if (!string.IsNullOrEmpty(_message))
{
    <p class="mt-3">@_message</p>
}

<hr />

<h4>Histórico de Receitas</h4>

@if (_incomes.Any())
{
    <table class="table table-striped mt-3">
        <thead>
            <tr>
                <th>Data</th>
                <th>Descrição</th>
                <th>Valor</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var income in _incomes)
            {
                <tr>
                    <td>@income.Date.ToString("dd/MM/yyyy")</td>
                    <td>@income.Description</td>
                    <td>R$ @income.Amount</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-muted mt-3">Nenhuma receita cadastrada.</p>
}

@code {
    private decimal Amount;
    private string Description = string.Empty;
    private DateTime Date = DateTime.Today;

    private bool _loading;
    private string? _message;

    private List<IncomeResponse> _incomes = new();

    protected override async Task OnInitializedAsync()
    {
        await CarregarIncomes();
    }

    private async Task CarregarIncomes()
    {
        _incomes = (await IncomeService.GetAllAsync()).ToList();
    }

    private async Task Salvar()
    {
        _loading = true;
        _message = null;

        try
        {
            await IncomeService.AddAsync(new(
                Amount,
                Description,
                Date));

            _message = "Receita adicionada com sucesso!";

            Amount = 0;
            Description = string.Empty;
            Date = DateTime.Today;

            await CarregarIncomes();
        }
        catch
        {
            _message = "Erro ao salvar a receita.";
        }
        finally
        {
            _loading = false;
        }
    }
}

