@page "/income"
@using Financeiro.App.Client.DTOs.IncomeDtos
@using Financeiro.App.Client.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

@inject IncomeService IncomeService

<h3>Adicionar Receita</h3>

<div class="mb-3">
    <label>Valor</label>
    <input type="number" class="form-control" @bind="Amount" />
</div>

<div class="mb-3">
    <label>Descrição</label>
    <input class="form-control" @bind="Description" />
</div>

<div class="mb-3">
    <label>Data</label>
    <input type="date" class="form-control" @bind="Date" />
</div>

<button class="btn btn-primary" @onclick="Salvar" disabled="@_loading">
    Salvar
</button>

@if (!string.IsNullOrEmpty(_message))
{
    <p class="mt-3">@_message</p>
}

<hr />

<h4>Histórico de Receitas</h4>

@if (_incomes.Any())
{
    <table class="table table-striped mt-3">
        <thead>
            <tr>
                <th>Data</th>
                <th>Descrição</th>
                <th>Valor</th>
                <th style="width: 120px"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var income in _incomes)
            {
                <tr>
                    @if (_editingIncomeId == income.Id)
                    {
                        <td>
                            <input type="date" class="form-control"
                                   @bind="_editDate" />
                        </td>
                        <td>
                            <input class="form-control"
                                   @bind="_editDescription" />
                        </td>
                        <td>
                            <input type="number" class="form-control"
                                   @bind="_editAmount" />
                        </td>
                        <td>
                            <div class="d-flex gap-2">
                                <button class="btn btn-success btn-sm"
                                        @onclick="() => SalvarEdicao(income.Id)"
                                        disabled="@_loading">
                                    Salvar
                                </button>

                                <button class="btn btn-secondary btn-sm"
                                        @onclick="CancelarEdicao"
                                        disabled="@_loading">
                                    Cancelar
                                </button>
                            </div>
                        </td>
                    }
                    else
                    {
                        <td>@income.Date.ToString("dd/MM/yyyy")</td>
                        <td>@income.Description</td>
                        <td>R$ @income.Amount</td>
                        <td>
                            <div class="d-flex gap-2">
                                <button class="btn btn-warning btn-sm"
                                        @onclick="() => Editar(income)"
                                        disabled="@_loading">
                                    Editar
                                </button>

                                <button class="btn btn-danger btn-sm"
                                        @onclick="() => Apagar(income.Id)"
                                        disabled="@_loading">
                                    Apagar
                                </button>
                            </div>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-muted mt-3">Nenhuma receita cadastrada.</p>
}

@code {

    private Guid? _editingIncomeId;

    private decimal _editAmount;
    private string _editDescription = string.Empty;
    private DateTime _editDate;

    private decimal Amount;
    private string Description = string.Empty;
    private DateTime Date = DateTime.Today;

    private bool _loading;
    private string? _message;

    private List<IncomeResponse> _incomes = new();

    protected override async Task OnInitializedAsync()
    {
        await CarregarIncomes();
    }

    private async Task CarregarIncomes()
    {
        _incomes = (await IncomeService.GetAllAsync()).ToList();
    }

    private async Task Salvar()
    {
        _loading = true;
        _message = null;

        try
        {
            await IncomeService.AddAsync(new(
                Amount,
                Description,
                Date));

            _message = "Receita adicionada com sucesso!";

            Amount = 0;
            Description = string.Empty;
            Date = DateTime.Today;

            await CarregarIncomes();
        }
        catch
        {
            _message = "Erro ao salvar a receita.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task Apagar(Guid incomeId)
    {
        _loading = true;
        _message = null;

        try
        {
            await IncomeService.DeleteAsync(incomeId);
            _message = "Receita apagada com sucesso!";
            await CarregarIncomes();
        }
        catch
        {
            _message = "Erro ao apagar a receita.";
        }
        finally
        {
            _loading = false;
        }
    }

    private void Editar(IncomeResponse income)
    {
        _editingIncomeId = income.Id;

        _editAmount = income.Amount;
        _editDescription = income.Description;
        _editDate = income.Date;
    }

    private void CancelarEdicao()
    {
        _editingIncomeId = null;
    }

    private async Task SalvarEdicao(Guid id)
    {
        _loading = true;
        _message = null;

        try
        {
            await IncomeService.UpdateAsync(id, new(
                _editAmount,
                _editDescription,
                _editDate));

            _message = "Receita atualizada com sucesso!";

            _editingIncomeId = null;

            await CarregarIncomes();
        }
        catch
        {
            _message = "Erro ao atualizar a receita.";
        }
        finally
        {
            _loading = false;
        }
    }
}

