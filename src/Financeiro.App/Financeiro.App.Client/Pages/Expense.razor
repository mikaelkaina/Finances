@page "/expense"
@using Financeiro.App.Client.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

@inject ExpenseService ExpenseService

<h3>Adicionar Despesa</h3>

<div class="mb-3">
    <label>Valor</label>
    <input type="number" class="form-control" @bind="Amount" />
</div>

<div class="mb-3">
    <label>Descrição</label>
    <input class="form-control" @bind="Description" />
</div>

<div class="mb-3">
    <label>Data</label>
    <input type="date" class="form-control" @bind="Date" />
</div>

<button class="btn btn-primary" @onclick="Salvar" disabled="@_loading">
    Salvar
</button>
@if (!string.IsNullOrEmpty(_message))
{
    <p class="mt-3">@_message</p>
}

@code {
    private decimal Amount;
    private string Description = string.Empty;
    private DateTime Date = DateTime.Today;

    private bool _loading;
    private string? _message;

    private async Task Salvar()
    {
        _loading = true;
        _message = null;

        try
        {
            await ExpenseService.AddAsync(new(
                Amount,
                Description,
                Date));

            _message = "Despesa adicionada com sucesso!";
            Amount = 0;
            Description = string.Empty;
            Date = DateTime.Today;
        }
        catch
        {
            _message = "Erro ao salvar a despesa.";
        }
        finally
        {
            _loading = false;
        }
    }
}
