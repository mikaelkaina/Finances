@page "/expense"
@using Financeiro.App.Client.DTOs.ExpenseDtos
@using Financeiro.App.Client.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

@inject ExpenseService ExpenseService

<h3>Adicionar Despesa</h3>

<div class="mb-3">
    <label>Valor</label>
    <input type="number" class="form-control" @bind="Amount" />
</div>

<div class="mb-3">
    <label>Descrição</label>
    <input class="form-control" @bind="Description" />
</div>

<div class="mb-3">
    <label>Data</label>
    <input type="date" class="form-control" @bind="Date" />
</div>

<button class="btn btn-primary" @onclick="Salvar" disabled="@_loading">
    Salvar
</button>

@if (!string.IsNullOrEmpty(_message))
{
    <p class="mt-3">@_message</p>
}

<hr />

<h4>Histórico de Despesas</h4>

@if (_expenses.Any())
{
    <table class="table table-striped mt-3">
        <thead>
            <tr>
                <th>Data</th>
                <th>Descrição</th>
                <th>Valor</th>
                <th style="width: 120px"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var expense in _expenses)
            {
                <tr>
                    @if (_editingExpenseId == expense.Id)
                    {
                        <td>
                            <input type="date" class="form-control"
                                   @bind="_editDate" />
                        </td>
                        <td>
                            <input class="form-control"
                                   @bind="_editDescription" />
                        </td>
                        <td>
                            <input type="number" class="form-control"
                                   @bind="_editAmount" />
                        </td>
                        <td>
                            <div class="d-flex gap-2">
                                <button class="btn btn-success btn-sm"
                                        @onclick="() => SalvarEdicao(expense.Id)"
                                        disabled="@_loading">
                                    Salvar
                                </button>

                                <button class="btn btn-secondary btn-sm"
                                        @onclick="CancelarEdicao"
                                        disabled="@_loading">
                                    Cancelar
                                </button>
                            </div>
                        </td>
                    }
                    else
                    {
                        <td>@expense.Date.ToString("dd/MM/yyyy")</td>
                        <td>@expense.Description</td>
                        <td>R$ @expense.Amount</td>
                        <td>
                            <div class="d-flex gap-2">
                                <button class="btn btn-warning btn-sm"
                                        @onclick="() => Editar(expense)"
                                        disabled="@_loading">
                                    Editar
                                </button>

                                <button class="btn btn-danger btn-sm"
                                        @onclick="() => Apagar(expense.Id)"
                                        disabled="@_loading">
                                    Apagar
                                </button>
                            </div>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-muted mt-3">Nenhuma despesa cadastrada.</p>
}

@code {
    private Guid? _editingExpenseId;

    private decimal _editAmount;
    private string _editDescription = string.Empty;
    private DateTime _editDate;

    private decimal Amount;
    private string Description = string.Empty;
    private DateTime Date = DateTime.Today;

    private bool _loading;
    private string? _message;

    private List<ExpenseResponse> _expenses = new();

    protected override async Task OnInitializedAsync()
    {
        await CarregarExpenses();
    }

    private async Task CarregarExpenses()
    {
        _expenses = (await ExpenseService.GetAllAsync()).ToList();
    }

    private async Task Salvar()
    {
        _loading = true;
        _message = null;

        try
        {
            await ExpenseService.AddAsync(new(
                Amount,
                Description,
                Date));

            _message = "Despesa adicionada com sucesso!";

            Amount = 0;
            Description = string.Empty;
            Date = DateTime.Today;

            await CarregarExpenses();
        }
        catch
        {
            _message = "Erro ao salvar a despesa.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task Apagar(Guid expenseId)
    {
        _loading = true;
        _message = null;

        try
        {
            await ExpenseService.DeleteAsync(expenseId);
            _message = "Despesa apagada com sucesso!";
            await CarregarExpenses();
        }
        catch
        {
            _message = "Erro ao apagar a despesa.";
        }
        finally
        {
            _loading = false;
        }
    }

    private void Editar(ExpenseResponse expense)
    {
        _editingExpenseId = expense.Id;

        _editAmount = expense.Amount;
        _editDescription = expense.Description;
        _editDate = expense.Date;
    }

    private void CancelarEdicao()
    {
        _editingExpenseId = null;
    }

    private async Task SalvarEdicao(Guid id)
    {
        _loading = true;
        _message = null;

        try
        {
            await ExpenseService.UpdateAsync(id, new(
                _editAmount,
                _editDescription,
                _editDate
            ));

            _message = "Receita atualizada com sucesso!";

            _editingExpenseId = null;

            await CarregarExpenses();
        }
        catch
        {
            _message = "Erro ao atualizar a receita.";
        }
        finally
        {
            _loading = false;
        }
    }
}
