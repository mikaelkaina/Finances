@page "/expense"
@using Financeiro.App.Client.DTOs.ExpenseDtos
@using Financeiro.App.Client.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

@inject ExpenseService ExpenseService

<h3>Adicionar Despesa</h3>

<div class="mb-3">
    <label>Valor</label>
    <input type="number" class="form-control" @bind="Amount" />
</div>

<div class="mb-3">
    <label>Descrição</label>
    <input class="form-control" @bind="Description" />
</div>

<div class="mb-3">
    <label>Data</label>
    <input type="date" class="form-control" @bind="Date" />
</div>

<button class="btn btn-primary" @onclick="Salvar" disabled="@_loading">
    Salvar
</button>

@if (!string.IsNullOrEmpty(_message))
{
    <p class="mt-3">@_message</p>
}

<hr />

<h4>Histórico de Despesas</h4>

@if (_expenses.Any())
{
    <table class="table table-striped mt-3">
        <thead>
            <tr>
                <th>Data</th>
                <th>Descrição</th>
                <th>Valor</th>
                <th style="width: 120px"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var income in _expenses)
            {
                <tr>
                    <td>@income.Date.ToString("dd/MM/yyyy")</td>
                    <td>@income.Description</td>
                    <td>R$ @income.Amount</td>
                    <td>
                        <button class="btn btn-danger btn-sm"
                                @onclick="() => Apagar(income.Id)"
                                disabled="@_loading">
                            Apagar
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-muted mt-3">Nenhuma despesa cadastrada.</p>
}

@code {
    private decimal Amount;
    private string Description = string.Empty;
    private DateTime Date = DateTime.Today;

    private bool _loading;
    private string? _message;

    private List<ExpenseResponse> _expenses = new();

    protected override async Task OnInitializedAsync()
    {
        await CarregarExpenses();
    }

    private async Task CarregarExpenses()
    {
        _expenses = (await ExpenseService.GetAllAsync()).ToList();
    }

    private async Task Salvar()
    {
        _loading = true;
        _message = null;

        try
        {
            await ExpenseService.AddAsync(new(
                Amount,
                Description,
                Date));

            _message = "Despesa adicionada com sucesso!";

            Amount = 0;
            Description = string.Empty;
            Date = DateTime.Today;

            await CarregarExpenses();
        }
        catch
        {
            _message = "Erro ao salvar a despesa.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task Apagar(Guid expenseId)
    {
        _loading = true;
        _message = null;

        try
        {
            await ExpenseService.DeleteAsync(expenseId);
            _message = "Despesa apagada com sucesso!";
            await CarregarExpenses();
        }
        catch
        {
            _message = "Erro ao apagar a despesa.";
        }
        finally
        {
            _loading = false;
        }
    }
}
